# App settings. Copy to .env.{profile} (development | production); those files are git-ignored.
# Real environment variables override values in the file. Production refuses to start while
# SECRET_KEY, APP_DB_URL or REDIS_URL are missing or still contain a placeholder.
APP_PROFILE=development
SECRET_KEY=change-me
APP_DB_URL=mysql+pymysql://mccms:***@db:3306/mccms?charset=utf8mb4
APP_DB_MIGRATION_URL=mysql+pymysql://mccms_migrator:***@db:3306/mccms?charset=utf8mb4
REDIS_URL=redis://:***@redis:6379/0
SOURCE_DB_URL=mysql+pymysql://sim_ro:***@db:3306/fmh_source_sim
SOURCE_MAPPING_FILE=config/source_mapping.dev.yml
SOURCE_QUERY_TIMEOUT_SEC=300
ETL_CRON=0 1 * * *
ETL_ENABLED=true
TZ=Africa/Harare
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=8
SESSION_COOKIE_NAME=mccms_session
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MAX_AGE_DAYS=90
AUTH_PROVIDER=local
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=10
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_RETENTION_YEARS=7
DEFAULT_CURRENCY=USD
# true when running behind nginx (trusts one proxy hop for client IP and https scheme)
BEHIND_PROXY=true
GUNICORN_WORKERS=4
